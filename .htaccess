# ==============================
#  GREAT SILKYWAY - .htaccess
#  Bezpecnostni pravidla (zpevneno)
# ==============================

# --- Zakaz vypisu obsahu slozek ---
Options -Indexes -MultiViews
ServerSignature Off

# --- Limit velikosti requestu (50 MB - kvuli nahravani fotek pres admin) ---
LimitRequestBody 52428800

# --- Blokovat citlive soubory podle nazvu / pripony ---
<FilesMatch "(^\.|\.(env|env\..*|db|sqlite|sqlite3|sql|log|bak|old|swp|tmp|ini|conf|key|pem|crt|cer|p12|pfx|ps1|bat|sh|mjs|ts|tsx|md|yml|yaml|toml|lock|gitignore|gitattributes|npmrc|prettierrc.*|gitconfig|htpasswd|DS_Store|map)$|composer\.(json|lock)|package(-lock)?\.json|payload\.db|webpack\.config\.|tsconfig\.|vitest\.|playwright\.)">
  Require all denied
</FilesMatch>

# --- Vyjimky: content.json MUSI byt verejny (cte ho web) ---
<Files "content.json">
  Require all granted
</Files>

# --- Blokovat cele citlive slozky ---
RedirectMatch 404 ^/\.git(/.*)?$
RedirectMatch 404 ^/\.github(/.*)?$
RedirectMatch 404 ^/cms(/.*)?$
RedirectMatch 404 ^/node_modules(/.*)?$
RedirectMatch 404 ^/tests(/.*)?$
RedirectMatch 404 ^/\.vscode(/.*)?$
RedirectMatch 404 ^/\.claude(/.*)?$
RedirectMatch 404 ^/\.well-known/(?!acme-challenge)
RedirectMatch 404 ^/media(/.*)?$

# --- Vynutit HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS redirect
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Blokovat HTTP metody krome standardnich
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT|OPTIONS)$
  RewriteRule .* - [F,L]

  # Blokovat zname utocne user-agenty (scanery, scrapers)
  RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|nmap|masscan|curl/[0-6]\.|libwww|wget|python-requests|go-http-client) [NC]
  RewriteCond %{REQUEST_URI} !^/content\.json$
  RewriteRule .* - [F,L]

  # Blokovat pristup k souborum s null bytem nebo nebezpecnymi vzory v URL
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%00|<script|union\s+select|base64_decode) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# --- Bezpecnostni hlavicky ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"

  # HSTS - vynuti HTTPS na 1 rok (HTTPS uz mas zapnute)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy - povoli vlastni inline skripty/styly (web je pouziva),
  # ale blokuje cizi JS, frames, plugins atd.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # Skryt podpisy
  Header unset X-Powered-By
  Header unset Server
  Header always unset X-Powered-By

  # content.json - kratky cache aby se zmeny rychle projevily, ale s revalidaci
  <FilesMatch "^content\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # admin.html - nikdy necachovat
  <FilesMatch "^(admin\.html|stats\.php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# --- Vypnout PHP exposed header ---
<IfModule mod_php.c>
  php_flag expose_php Off
  php_flag allow_url_fopen Off
  php_flag allow_url_include Off
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
</IfModule>

# --- Vychozi stranka ---
DirectoryIndex index.html index.php

# --- Ochrana admin rozhrani HTTP Basic Auth ---
<FilesMatch "^(admin\.html|stats\.php)$">
  AuthType Basic
  AuthName "Great Silkyway - Admin"
  AuthUserFile /data/web/virtuals/397564/virtual/www/domains/greatsilkyway.cz/.htpasswd-admin
  Require valid-user
</FilesMatch>

# --- Cache statickych souboru ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# --- Komprese ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
