# ==============================
#  GREAT SILKYWAY - .htaccess
#  Bezpecnostni pravidla
# ==============================

# --- Zakaz vypisu obsahu slozek ---
Options -Indexes

# --- Skryt podpisy serveru ---
ServerSignature Off

# --- Blokovat citlive soubory podle nazvu / pripony ---
<FilesMatch "(^\.|\.(env|env\..*|db|sqlite|sqlite3|sql|log|bak|old|swp|tmp|ini|conf|key|pem|crt|cer|p12|pfx|ps1|bat|sh|mjs|ts|tsx|md|yml|yaml|toml|lock|gitignore|gitattributes|npmrc|prettierrc.*|gitconfig|htpasswd|DS_Store|map)$|composer\.(json|lock)|package(-lock)?\.json|payload\.db|webpack\.config\.|tsconfig\.|vitest\.|playwright\.)">
  Require all denied
</FilesMatch>

# --- Vyjimka: content.json MUSI byt verejny ---
<Files "content.json">
  Require all granted
</Files>

# --- Blokovat cele citlive slozky ---
RedirectMatch 404 ^/\.git(/.*)?$
RedirectMatch 404 ^/\.github(/.*)?$
RedirectMatch 404 ^/cms(/.*)?$
RedirectMatch 404 ^/node_modules(/.*)?$
RedirectMatch 404 ^/tests(/.*)?$
RedirectMatch 404 ^/\.vscode(/.*)?$
RedirectMatch 404 ^/\.claude(/.*)?$
RedirectMatch 404 ^/media(/.*)?$

# --- Vynutit HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Bezpecnostni hlavicky ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header unset X-Powered-By
  Header always unset X-Powered-By

  <FilesMatch "^content\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(admin\.html|stats\.php|save-content\.php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

# --- Vychozi stranka ---
DirectoryIndex index.html index.php

# --- Ochrana admin rozhrani HTTP Basic Auth ---
<FilesMatch "^(admin\.html|stats\.php|save-content\.php)$">
  AuthType Basic
  AuthName "Great Silkyway - Admin"
  AuthUserFile /data/web/virtuals/397564/virtual/www/domains/greatsilkyway.cz/.htpasswd-admin
  Require valid-user
</FilesMatch>

# --- Cache statickych souboru ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
